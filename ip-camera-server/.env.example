# Найдите IPv4 компьютера командой ipconfig и укажите его здесь.
HOST_IP=192.168.1.50

# Замените длинным случайным ключом. Тот же ключ вводится в PWA.
CAMERA_TOKEN=replace-with-a-long-random-token

# Пароль для веб-панели ONVIF Proxy (http://HOST_IP:8080).
ONVIF_WEB_USERNAME=admin
ONVIF_WEB_PASSWORD=replace-this-admin-password